{#
  Few-shot examples, rendered from the structured data of app/context/examples.py in the
  requested output format (S04 design D5). Spanish labels, `medium` granularity. No
  arithmetic here: per-phase figures and totals come precomputed. Every rendered example
  must score 1.0 in the structural evaluation of its format.
#}
{% macro phase_label(key) %}{{ (phases | selectattr("key", "equalto", key) | first).label_es }}{% endmacro %}
{% macro totals(example) %}
### Totales
- **Total de horas:** {{ example.total_hours }}
- **Coste total:** {{ example.total_cost_eur | amount }} EUR
- **Equipo recomendado:** {{ example.team }}
- **Duración estimada:** {{ example.duration_weeks[0] }}-{{ example.duration_weeks[1] }} semanas
{%- endmacro %}
{% macro risks(example) %}
### Supuestos y riesgos
{% for risk in example.risks %}
- {{ risk }}
{% endfor %}
{%- endmacro %}
<examples>
{% for example in examples %}
<example>
<example_request>
<project_type>{{ example.project_type }}</project_type>
<client_request>
{{ example.meeting_summary }}
</client_request>
</example_request>
<example_estimate>
## Estimación: {{ example.title }}

{% if output_format == "line_items" %}
### Desglose de tareas
| Tarea | Horas | Coste (EUR) |
|---|---|---|
{% for row in example.rows %}
| {{ row.task }} | {{ row.hours }} | {{ row.cost_eur | amount }} |
{% endfor %}

{{ totals(example) }}

{{ risks(example) -}}
{% elif output_format == "phases_table" %}
### Desglose por fases
| Fase | Horas | Coste (EUR) | Confianza (%) |
|---|---|---|---|
{% for phase in example.phases %}
| {{ phase_label(phase.phase) }} | {{ phase.hours }} | {{ phase.cost_eur | amount }} | {{ phase.confidence_pct }} |
{% endfor %}

{{ totals(example) }}

{{ risks(example) -}}
{% else %}
La propuesta cubre estas tareas: {% for row in example.rows %}{{ row.task }}{{ "; " if not loop.last else "." }}{% endfor +%}

El trabajo se organiza en {{ example.phases | length }} fases: {% for phase in example.phases %}{{ phase_label(phase.phase) }}, {{ phase.hours }} horas ({{ phase.cost_eur | amount }} EUR){{ "; " if not loop.last else "." }}{% endfor +%}

Riesgos y supuestos principales: {{ example.risks | join(" ") }}

{{ totals(example) }}
{% endif %}
</example_estimate>
</example>
{% endfor %}
</examples>
