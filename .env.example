# Required: the API key of the PRIMARY_MODEL provider.
# Optional: the key of the FALLBACK_MODEL provider (without it, the fallback is disabled).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# PRIMARY_MODEL=gpt-4o-mini        # openai or anthropic model
# FALLBACK_MODEL=claude-haiku-4-5  # unset: default model of the other provider; empty disables
# LLM_TIMEOUT=60                   # seconds per attempt, > 0
# LLM_RETRIES=2                    # retries per model, >= 0
# STRUCTURED_MAX_RETRIES=2         # structured-output validation retries, 0..5
# MODERATION_ENABLED=true          # input moderation guardrail
# REDIS_URL=redis://localhost:6379/0  # empty disables the response cache
# CACHE_TTL=86400                  # seconds, > 0
# MAX_CONVERSATION_TURNS=6         # user + assistant messages kept per session, 1..50
# MAX_SESSIONS=1000                # in-memory sessions before evicting the least used, 1..100000
# MAX_ATTACHMENTS=5                # files per turn, 0..20 (0 disables attachments)
# MAX_ATTACHMENT_BYTES=10485760    # bytes per file, 1024..52428800
# MAX_ATTACHMENT_CHARS=60000       # extracted characters per turn in total, 1000..200000
# APP_ENV=development              # production = JSON logs
# LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Streamlit UI only: URL of the estimation API (default shown)
# ESTIMATOR_API_BASE_URL=http://localhost:8000
